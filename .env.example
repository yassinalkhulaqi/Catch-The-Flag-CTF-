# =============================================================
# Catch The Flag — environment configuration
# Copy to .env (root) for docker compose; apps carry their own
# .env (Laravel) / .env.local (Next.js) — see docs/development.md
# NO SECRETS IN GIT. Values below are safe development defaults.
# =============================================================

# ---------- Root / docker compose ----------
COMPOSE_PROJECT_NAME=ctf

# PostgreSQL (local dev service)
POSTGRES_DB=catch_the_flag
POSTGRES_USER=ctf
POSTGRES_PASSWORD=ctf_secret_local_only
POSTGRES_PORT=5433

# ---------- Laravel API (apps/api/.env) ----------
APP_NAME="Catch The Flag"
APP_ENV=local
APP_KEY=                # generated: php artisan key:generate (REQUIRED, keep secret)
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

# Where the browser-facing app lives (CORS allowlist + links)
FRONTEND_URL=http://localhost:3000
# Base URL the Next.js BFF uses to reach the API (server-side only)
API_URL=http://localhost:8000

# Database
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=catch_the_flag
DB_USERNAME=ctf
DB_PASSWORD=ctf_secret_local_only

# Cache / sessions / queues — database-first (ADR-0010); Redis is opt-in
CACHE_DRIVER=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database
# Redis (optional): set CACHE_DRIVER=redis + these
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail (log driver in dev; SMTP/SES/etc. in production)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@catchtheflag.local"
MAIL_FROM_NAME="${APP_NAME}"

# ---------- Storage (ADR-0009) ----------
# local = filesystem (dev), s3 = any S3-compatible provider (prod)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=storage/app
# S3-compatible (used when STORAGE_DRIVER=s3)
STORAGE_AWS_KEY=
STORAGE_AWS_SECRET=
STORAGE_AWS_REGION=us-east-1
STORAGE_AWS_BUCKET=
STORAGE_AWS_ENDPOINT=            # e.g. https://r2.cloudflarestorage.com or MinIO URL
STORAGE_AWS_USE_PATH_STYLE=false # true for MinIO

# ---------- Security / platform tunables ----------
# Max single challenge file upload (MB)
MAX_CHALLENGE_FILE_MB=64
# Rate limits (see docs/security.md §4)
RATE_LIMIT_AUTH_PER_MIN=5
RATE_LIMIT_REGISTER_PER_HOUR=3
RATE_LIMIT_SUBMIT_PER_CHALLENGE_PER_MIN=10
RATE_LIMIT_SUBMIT_PER_USER_PER_MIN=30
RATE_LIMIT_DOWNLOAD_PER_MIN=60
# Sanctum token lifetime in days
TOKEN_TTL_DAYS=30

# ---------- Seeds (change before any shared environment) ----------
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe-Admin-Passw0rd!

# ---------- Next.js web (apps/web/.env.local) ----------
# (safe defaults; no secrets belong here in V1)
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# API_URL is read server-side by the BFF proxy:
# API_URL=http://localhost:8000
# SESSION_COOKIE_NAME=ctf_session

# ---------- Optional: Redis service in compose ----------
# REDIS_ENABLED=false
