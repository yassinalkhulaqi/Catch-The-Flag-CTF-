APP_NAME="Catch The Flag"
APP_ENV=local
APP_KEY=                       # php artisan key:generate (REQUIRED — protects flag ciphertext/HMAC)
APP_DEBUG=true
APP_URL=http://localhost:8000

# Browser-facing origin (CORS allowlist, links)
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL — host `postgres` = docker compose service; native run: 127.0.0.1
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=catch_the_flag
DB_USERNAME=ctf
DB_PASSWORD=ctf_secret_local_only

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# Storage abstraction (ADR-0009): local | s3 (S3-compatible: AWS/R2/MinIO)
FILESYSTEM_DISK=local
STORAGE_DRIVER=local
STORAGE_CHALLENGE_DISK=challenge-files
STORAGE_AWS_KEY=
STORAGE_AWS_SECRET=
STORAGE_AWS_REGION=us-east-1
STORAGE_AWS_BUCKET=
STORAGE_AWS_ENDPOINT=
STORAGE_AWS_USE_PATH_STYLE_ENDPOINT=false

QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@catchtheflag.local"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Catch The Flag platform tunables (config/ctf.php) ----
MAX_CHALLENGE_FILE_MB=64
RATE_LIMIT_AUTH_PER_MIN=5
RATE_LIMIT_SUBMIT_PER_CHALLENGE_PER_MIN=10
RATE_LIMIT_SUBMIT_PER_USER_PER_MIN=30
RATE_LIMIT_DOWNLOAD_PER_MIN=60
TOKEN_TTL_DAYS=30

# ---- Demo seed data (change on any shared environment) ----
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe-Admin-Passw0rd!

VITE_APP_NAME="${APP_NAME}"
